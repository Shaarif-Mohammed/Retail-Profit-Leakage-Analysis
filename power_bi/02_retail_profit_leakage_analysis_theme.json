{
    "name": "Retail Profit Leakage - Consulting Theme",
    "dataColors": [
        "#006872",
        "#00BB8D",
        "#01AEC5",
        "#003B93",
        "#83C5BE",
        "#CA6702",
        "#616161",
        "#264653"
    ],
    "background": "#FAFAFA",
    "foreground": "#212121",
    "tableAccent": "#006D77",
    "good": "#15C845",
    "neutral": "#EE9B00",
    "bad": "#AE2012",
    "textClasses": {
        "title": {
            "fontFace": "Segoe UI Semibold",
            "fontSize": 16,
            "color": "#0B006D"
        },
        "header": {
            "fontFace": "Segoe UI Semibold",
            "fontSize": 12,
            "color": "#653200"
        },
        "label": {
            "fontFace": "Segoe UI",
            "fontSize": 10,
            "color": "#0B006D"
        },
        "callout": {
            "fontFace": "Segoe UI Semibold",
            "fontSize": 28,
            "color": "#653200"
        }
    },
    "visualStyles": {
        "*": {
            "*": {
                "background": [
                    {
                        "show": true,
                        "color": {
                            "solid": {
                                "color": "#FAFAFA"
                            }
                        },
                        "transparency": 100
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ],
                "visualHeader": [
                    {
                        "show": false,
                        "transparency": 0
                    }
