                ],
                "labels": [
                    {
                        "color": {
                            "solid": {
                                "color": "#212121"
                            }
                        },
                        "fontSize": 26,
                        "fontFamily": "Segoe UI Semibold"
                    }
                ]
            }
        },
        "tableEx": {
            "*": {
                "background": [
                    {
                        "show": true,
                        "color": {
                            "solid": {
                                "color": "#FAFAFA"
                            }
                        },
                        "transparency": 0
