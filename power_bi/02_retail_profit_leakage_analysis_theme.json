                        "transparency": 0
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ],
                "header": [
                    {
                        "show": true,
                        "fontColor": {
                            "solid": {
                                "color": "#212121"
                            }
                        },
                        "textSize": 10,
                        "fontFamily": "Segoe UI Semibold"
