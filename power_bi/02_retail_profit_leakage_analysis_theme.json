                "title": [
                    {
                        "show": true,
                        "fontColor": {
                            "solid": {
                                "color": "#212121"
                            }
                        },
                        "fontFamily": "Segoe UI Semibold",
                        "fontSize": 12
                    }
                ],
                "legend": [
                    {
                        "show": true,
                        "labelColor": {
                            "solid": {
                                "color": "#616161"
                            }
                        },
                        "fontFamily": "Segoe UI",
                        "fontSize": 9
                    }
                ],
                "categoryAxis": [
                    {
                        "labelColor": {
                            "solid": {
                                "color": "#616161"
                            }
                        },
                        "titleColor": {
                            "solid": {
                                "color": "#212121"
                            }
                        },
                        "fontSize": 9,
                        "titleFontSize": 10,
                        "showAxisTitle": true
                    }
                ],
                "valueAxis": [
                    {
                        "labelColor": {
                            "solid": {
                                "color": "#616161"
                            }
