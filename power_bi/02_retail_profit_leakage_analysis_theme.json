                        "fontSize": 9
                    }
                ],
                "outspacePane": [
                    {
                        "transparency": 100
                    }
                ]
            }
        },
        "card": {
            "*": {
                "background": [
                    {
                        "show": true,
                        "color": {
                            "solid": {
                                "color": "#FAFAFA"
