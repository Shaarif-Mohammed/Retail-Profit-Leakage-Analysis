                        "transparency": 0
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ],
                "categoryLabels": [
                    {
                        "show": true,
                        "color": {
                            "solid": {
                                "color": "#616161"
                            }
                        },
                        "fontSize": 11
