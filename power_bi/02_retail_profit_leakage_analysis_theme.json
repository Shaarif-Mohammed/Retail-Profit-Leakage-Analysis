                "items": [
                    {
                        "fontColor": {
                            "solid": {
                                "color": "#212121"
                            }
                        },
                        "textSize": 10,
                        "fontFamily": "Segoe UI"
                    }
                ]
            }
        },
        "page": {
            "*": {
                "background": [
                    {
                        "color": {
                            "solid": {
                                "color": "#F4F4EB"
                            }
                        },
                        "transparency": 0
                    }
                ],
                "outspace": [
                    {
                        "color": {
                            "solid": {
                                "color": "#F4F4EB"
                            }
                        },
                        "transparency": 0
                    }
                ]
            }
        }
    },
    "minimum": "#84A9FE",
    "center": "#2B82FD",
    "maximum": "#001D65"
}